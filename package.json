{
  "name": "hmdentalassistant_front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "changeset": "changeset",
    "version-packages": "changeset version && npm version --allow-same-version --no-git-tag-version --ignore-scripts $(node -p \"require('./package.json').version\")",
    "prebuild": "node scripts/qa/enforce-https-api-url.js production",
    "serve": "npm run serve:d2",
    "serve:d2": "node scripts/dev-auth-mode.js d2",
    "serve:legacy": "node scripts/dev-auth-mode.js legacy",
    "serve:lan": "node scripts/dev-auth-mode.js d2 --host 0.0.0.0 --port 8081",
    "serve:lan:legacy": "node scripts/dev-auth-mode.js legacy --host 0.0.0.0 --port 8081",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider vue-cli-service build",
    "prebuild-stage": "node scripts/qa/enforce-https-api-url.js staging",
    "build-stage": "cross-env NODE_OPTIONS=--openssl-legacy-provider vue-cli-service build --mode staging",
    "qa:api-url-https": "node scripts/qa/enforce-https-api-url.js production && node scripts/qa/enforce-https-api-url.js staging",
    "lint": "cross-env NODE_OPTIONS=--openssl-legacy-provider vue-cli-service lint"
  },
  "dependencies": {
    "@egjs/flicking-plugins": "^4.2.3",
    "@egjs/vue-flicking": "^4.5.2",
    "@fortawesome/fontawesome-svg-core": "^1.2.36",
    "@fortawesome/free-solid-svg-icons": "^5.15.4",
    "@fortawesome/vue-fontawesome": "^2.0.6",
    "@mdi/font": "^6.4.95",
    "@paypal/paypal-js": "^5.0.3",
    "axios": "1.20.0",
    "core-js": "^3.6.5",
    "crypto-js": "^4.1.1",
    "dompurify": "3.4.17",
    "jwt-decode": "^3.1.2",
    "lottie-vuejs": "^0.4.0",
    "moment": "^2.29.1",
    "qrcode.vue": "^1.7.0",
    "sweetalert2": "^11.1.9",
    "v-mask": "^2.3.0",
    "v-viewer": "^1.7.1",
    "vue": "2.6.14",
    "vue-advanced-cropper": "^1.11.6",
    "vue-apexcharts": "^1.6.2",
    "vue-masked-input": "^0.5.2",
    "vue-plugin-load-script": "^2.1.0",
    "vue-router": "^3.2.0",
    "vue-session": "^1.0.0",
    "vue-signature-pad": "^2.0.5",
    "vue-sweetalert2": "^5.0.5",
    "vue-toastification": "^0.5.0",
    "vue-typer": "^1.2.0",
    "vue-uuid": "^2.1.0",
    "vue2-dropzone": "^3.6.0",
    "vuelidate": "^0.7.6",
    "vuetify": "^2.6.4",
    "vuex": "^3.4.0"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@playwright/test": "^1.60.0",
    "@vue/cli-plugin-babel": "~4.5.0",
    "@vue/cli-plugin-eslint": "~4.5.0",
    "@vue/cli-plugin-router": "~4.5.0",
    "@vue/cli-plugin-vuex": "~4.5.0",
    "@vue/cli-service": "~4.5.0",
    "autoprefixer": "^9.8.6",
    "babel-eslint": "^10.1.0",
    "cross-env": "^7.0.3",
    "deepmerge": "^4.2.2",
    "eslint": "^6.7.2",
    "eslint-plugin-vue": "^6.2.2",
    "jsdom": "30.1.2",
    "postcss": "^7.0.36",
    "sass": "^1.32.13",
    "sass-loader": "^10",
    "tailwindcss": "npm:@tailwindcss/postcss7-compat@^2.2.9",
    "vue-template-compiler": "2.6.14"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "babel-eslint"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "overrides": {
    "lottie-vuejs": {
      "axios": "$axios"
    }
  }
}
